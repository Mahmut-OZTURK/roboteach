{
  "protocol": {
    "arm_name": "equal_budget_key_matched_verbal",
    "command_source": "canonical command_tr (identical to fair_cap_multiview)",
    "seeds_formula": "3000 + 100 * t_idx + tr (30 per task, 180 total)",
    "use_multiview": true,
    "use_ontology": false,
    "use_checkpoints": false,
    "auto_safe_lift": false,
    "priors": {
      "transit_z": 0.56,
      "release_margin_z": 0.075,
      "row_spacing": 0.062,
      "diagonal_delta": 0.062,
      "grasp_force": 75.0,
      "require_home_relocate": false
    },
    "injected_rules": "non-empty verbal_tips[-3:] collected on command_tr"
  },
  "calibration_verbal_tips": {
    "T1_STACK_ORDERED": {
      "command_tr": "kutuları kule gibi üst üste diz: en altta mavi, üstünde kırmızı, üstünde yeşil, en üstte sarı",
      "calib_iters_run": 2,
      "collected_tips": [
        "Center each upper cube within 0.025 m of the cube directly below it.",
        "Align the cubes at the same XY position and stack blue, red, green, then yellow vertically."
      ],
      "tip_count": 2
    },
    "T2_ALIGN_ROW": {
      "command_tr": "kırmızı, mavi, yeşil ve sarı küpleri yan yana tek sıra halinde diz",
      "calib_iters_run": 5,
      "collected_tips": [
        "Place consecutive cubes at similar Y coordinates with consistent X spacing.",
        "Align the red cube’s Y position with the other cubes within 0.03 m."
      ],
      "tip_count": 2
    },
    "T3_DIAGONAL_PAIR": {
      "command_tr": "kırmızının çaprazına mavi kutuyu, sarının çaprazına yeşil kutuyu koy",
      "calib_iters_run": 3,
      "collected_tips": [
        "Place each target 0.04–0.11 m away from its reference along both X and Y.",
        "Place each target cube on the table with both X and Y offsets of 0.04–0.11 m from its reference cube."
      ],
      "tip_count": 2
    },
    "T4_PLACE_INSIDE": {
      "command_tr": "kırmızı, mavi ve yeşil küpleri kahverengi kutunun içine koy",
      "calib_iters_run": 2,
      "collected_tips": [
        "Place every cube fully within the opening and below the rim before releasing.",
        "Lower the green cube below the rim and center it within the box opening."
      ],
      "tip_count": 2
    },
    "T5_UNSTACK_SWAP": {
      "command_tr": "mavi küpü kırmızının üstüne koy ama kırmızı zaten mavinin üstünde",
      "calib_iters_run": 2,
      "collected_tips": [
        "Place red flat on the table, then center blue directly above it.",
        "Place blue directly above red, with horizontal offset under 0.025 m."
      ],
      "tip_count": 2
    },
    "T6_OBSTACLE_CLEARANCE": {
      "command_tr": "engelin üzerinden aşırarak mavi küpü kırmızı küpün üstüne koy",
      "calib_iters_run": 5,
      "collected_tips": [
        "Place the blue cube directly over the red cube, aligned within 0.025 m."
      ],
      "tip_count": 1
    }
